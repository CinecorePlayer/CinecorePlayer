+// Output unit pulls the binaural/speaker mix from the spatial mixer, which in
+// turn pulls the multichannel PCM from render_cb_lpcm.
+static OSStatus render_cb_spatial(void *ctx, AudioUnitRenderActionFlags *aflags,
+                                  const AudioTimeStamp *ts, UInt32 bus,
+                                  UInt32 frames, AudioBufferList *buffer_list)
+{
+    struct ao *ao   = ctx;
+    struct priv *p  = ao->priv;
+    return AudioUnitRender(p->mixer, aflags, ts, 0, frames, buffer_list);
+}
+
+// Which AUSpatialMixer output type fits the device, or 0 for "not spatial".
+static UInt32 spatial_output_type(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (p->spatial == SPATIAL_NO)
+        return 0;
+
+    uint32_t transport = 0;
+    CA_GET(p->device, kAudioDevicePropertyTransportType, &transport);
+
+    UInt32 type = 0;
+    switch (transport) {
+    case kAudioDeviceTransportTypeBluetooth:
+    case kAudioDeviceTransportTypeBluetoothLE:
+        type = kSpatialMixerOutputType_Headphones;
+        break;
+    case kAudioDeviceTransportTypeBuiltIn: {
+        uint32_t source = 0;
+        CA_GET_O(p->device, kAudioDevicePropertyDataSource, &source);
+        type = source == 'hdpn' ? kSpatialMixerOutputType_Headphones
+                                : kSpatialMixerOutputType_BuiltInSpeakers;
+        break;
+    }
+    default:
+        // HDMI receivers, USB DACs, AirPlay...: real speakers, no rendering
+        // unless forced.
+        type = p->spatial == SPATIAL_YES ? kSpatialMixerOutputType_Headphones : 0;
+        break;
+    }
+    char *t = mp_tag_str(transport);
+    MP_VERBOSE(ao, "spatial: transport %s -> output type %u\n", t, (unsigned)type);
+    return type;
+}
+
+// Keep the source layout (5.1, 7.1, 7.1.4, 9.1.6...) instead of the device's
+// stereo layout. Speakers CoreAudio cannot name fall back to 7.1/5.1.
+static bool spatial_init_chmap(struct ao *ao)
+{
+    if (ao->channels.num <= 2)
+        return false;
+    bool mappable = ao->channels.num <= 16;
+    for (int n = 0; mappable && n < ao->channels.num; n++) {
+        int label = mp_speaker_id_to_ca_label(ao->channels.speaker[n]);
+        if (label == -1 || label == kAudioChannelLabel_Unknown)
+            mappable = false;
+    }
+    if (mappable)
+        return true;
+
+    struct mp_chmap_sel sel = {0};
+    mp_chmap_sel_add_map(&sel, &(struct mp_chmap)MP_CHMAP_INIT_STEREO);
+    struct mp_chmap m51, m71;
+    mp_chmap_from_str(&m51, bstr0("5.1"));
+    mp_chmap_from_str(&m71, bstr0("7.1"));
+    mp_chmap_sel_add_map(&sel, &m51);
+    mp_chmap_sel_add_map(&sel, &m71);
+    struct mp_chmap map = ao->channels;
+    if (!ao_chmap_sel_adjust(ao, &sel, &map) || map.num <= 2)
+        return false;
+    ao->channels = map;
+    return true;
+}
