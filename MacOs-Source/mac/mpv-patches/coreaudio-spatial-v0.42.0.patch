+static bool init_spatial_mixer(struct ao *ao, UInt32 output_type,
+                               AudioStreamBasicDescription *out_asbd)
+{
+    struct priv *p = ao->priv;
+    OSStatus err;
+    AudioUnit mixer = NULL;
+
+    AudioComponentDescription desc = {
+        .componentType         = kAudioUnitType_Mixer,
+        .componentSubType      = kAudioUnitSubType_SpatialMixer,
+        .componentManufacturer = kAudioUnitManufacturer_Apple,
+    };
+    AudioComponent comp = AudioComponentFindNext(NULL, &desc);
+    if (!comp) {
+        MP_WARN(ao, "spatial: AUSpatialMixer not available\n");
+        return false;
+    }
+    err = AudioComponentInstanceNew(comp, &mixer);
+    CHECK_CA_ERROR("spatial: cannot open AUSpatialMixer");
+
+    UInt32 one = 1;
+    err = AudioUnitSetProperty(mixer, kAudioUnitProperty_ElementCount,
+                               kAudioUnitScope_Input, 0, &one, sizeof(one));
+    CHECK_CA_ERROR_L(fail, "spatial: cannot set input bus count");
+
+    UInt32 max_frames = 4096;
+    AudioUnitSetProperty(mixer, kAudioUnitProperty_MaximumFramesPerSlice,
+                         kAudioUnitScope_Global, 0, &max_frames, sizeof(max_frames));
+
+    // Input: the source channels with their speaker positions.
+    AudioStreamBasicDescription in_asbd;
+    ca_fill_asbd(ao, &in_asbd);
+    err = AudioUnitSetProperty(mixer, kAudioUnitProperty_StreamFormat,
+                               kAudioUnitScope_Input, 0, &in_asbd, sizeof(in_asbd));
+    CHECK_CA_ERROR_L(fail, "spatial: cannot set input format");
+
+    size_t layout_size = sizeof(AudioChannelLayout)
+                         + (ao->channels.num - 1) * sizeof(AudioChannelDescription);
+    AudioChannelLayout *layout = talloc_zero_size(NULL, layout_size);
+    layout->mChannelLayoutTag = kAudioChannelLayoutTag_UseChannelDescriptions;
+    layout->mNumberChannelDescriptions = ao->channels.num;
+    for (int n = 0; n < ao->channels.num; n++) {
+        layout->mChannelDescriptions[n].mChannelLabel =
+            mp_speaker_id_to_ca_label(ao->channels.speaker[n]);
+        layout->mChannelDescriptions[n].mChannelFlags = kAudioChannelFlags_AllOff;
+    }
+    ca_log_layout(ao, MSGL_V, layout);
+    err = AudioUnitSetProperty(mixer, kAudioUnitProperty_AudioChannelLayout,
+                               kAudioUnitScope_Input, 0, layout, layout_size);
+    talloc_free(layout);
+    CHECK_CA_ERROR_L(fail, "spatial: cannot set input channel layout");
+
+    // Output: stereo float at the source rate (the output unit converts to the
+    // device rate).
+    AudioStreamBasicDescription stereo = in_asbd;
+    stereo.mChannelsPerFrame = 2;
+    err = AudioUnitSetProperty(mixer, kAudioUnitProperty_StreamFormat,
+                               kAudioUnitScope_Output, 0, &stereo, sizeof(stereo));
+    CHECK_CA_ERROR_L(fail, "spatial: cannot set output format");
+    AudioChannelLayout stereo_layout = {
+        .mChannelLayoutTag = kAudioChannelLayoutTag_Stereo,
+    };
+    AudioUnitSetProperty(mixer, kAudioUnitProperty_AudioChannelLayout,
+                         kAudioUnitScope_Output, 0, &stereo_layout, sizeof(stereo_layout));
+
+    UInt32 algorithm = kSpatializationAlgorithm_UseOutputType;
+    err = AudioUnitSetProperty(mixer, kAudioUnitProperty_SpatializationAlgorithm,
+                               kAudioUnitScope_Input, 0, &algorithm, sizeof(algorithm));
+    CHECK_CA_ERROR_L(fail, "spatial: cannot set algorithm");
+
+    UInt32 mode = kSpatialMixerSourceMode_AmbienceBed;
+    err = AudioUnitSetProperty(mixer, kAudioUnitProperty_SpatialMixerSourceMode,
+                               kAudioUnitScope_Input, 0, &mode, sizeof(mode));
+    CHECK_CA_ERROR_L(fail, "spatial: cannot set bed mode");
+
+    err = AudioUnitSetProperty(mixer, kAudioUnitProperty_SpatialMixerOutputType,
+                               kAudioUnitScope_Global, 0, &output_type, sizeof(output_type));
+    CHECK_CA_ERROR_L(fail, "spatial: cannot set output type");
+
+    // A bed is far-field: no distance attenuation or in-head effects.
+    UInt32 flags = 0;
+    AudioUnitSetProperty(mixer, kAudioUnitProperty_SpatialMixerRenderingFlags,
+                         kAudioUnitScope_Input, 0, &flags, sizeof(flags));
+
+    if (output_type == kSpatialMixerOutputType_Headphones) {
+        UInt32 hrtf = kSpatialMixerPersonalizedHRTFMode_Auto;
+        AudioUnitSetProperty(mixer, kAudioUnitProperty_SpatialMixerPersonalizedHRTFMode,
+                             kAudioUnitScope_Global, 0, &hrtf, sizeof(hrtf));
+        UInt32 tracking = p->head_tracking;
+        err = AudioUnitSetProperty(mixer, kAudioUnitProperty_SpatialMixerEnableHeadTracking,
+                                   kAudioUnitScope_Global, 0, &tracking, sizeof(tracking));
+        CHECK_CA_WARN("spatial: head tracking not available");
+    }
+
+    AURenderCallbackStruct cb = {
+        .inputProc       = render_cb_lpcm,
+        .inputProcRefCon = ao,
+    };
+    err = AudioUnitSetProperty(mixer, kAudioUnitProperty_SetRenderCallback,
+                               kAudioUnitScope_Input, 0, &cb, sizeof(cb));
+    CHECK_CA_ERROR_L(fail, "spatial: cannot set mixer render callback");
+
+    err = AudioUnitInitialize(mixer);
+    CHECK_CA_ERROR_L(fail, "spatial: cannot initialize AUSpatialMixer");
+
+    p->mixer = mixer;
+    *out_asbd = stereo;
+    MP_INFO(ao, "spatial: %s rendered for %s%s\n", mp_chmap_to_str(&ao->channels),
+            output_type == kSpatialMixerOutputType_Headphones ? "headphones" : "built-in speakers",
+            output_type == kSpatialMixerOutputType_Headphones && p->head_tracking ? " (head tracking)" : "");
+    return true;
+
+fail:
+    AudioComponentInstanceDispose(mixer);
 coreaudio_error:
     return false;
 }
