+/* Cinecore (macOS): Apple's OpenGL reads textures back into client memory synchronously, stalling the CS thread on
+ * every frame until the GPU is idle (madVR's D3D11 path reads a 16-bit float frame per frame). For CPU-only DYNAMIC
+ * destinations backed by a pixel pack buffer, read with glReadPixels from the source's framebuffer into that
+ * buffer: the CS thread queues the copy and goes on; the application maps the buffer a frame or two later. */
+extern struct wined3d_texture *cinecore_download_dst;
+
+static BOOL cinecore_pbo_download(struct wined3d_context_gl *context_gl, struct wined3d_texture_gl *src_texture_gl,
+        unsigned int src_sub_resource_idx, unsigned int src_location, const struct wined3d_box *src_box,
+        const struct wined3d_bo_address *dst_bo_addr, const struct wined3d_format *dst_format,
+        unsigned int dst_x, unsigned int dst_y, unsigned int dst_z, unsigned int dst_row_pitch)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    struct wined3d_texture *dst = cinecore_download_dst, *src = &src_texture_gl->t;
+    const struct wined3d_format_gl *format_gl = wined3d_format_gl(src->resource.format);
+    unsigned int width = wined3d_texture_get_level_width(src, 0), height = wined3d_texture_get_level_height(src, 0);
+    static int logged;
 
+    if (!dst || !(dst->resource.usage & WINED3DUSAGE_DYNAMIC) || (dst->resource.access & WINED3D_RESOURCE_ACCESS_GPU)
+            || !dst_bo_addr->buffer_object)
+        return FALSE;
+    if (src_sub_resource_idx || dst_x || dst_y || dst_z || src_box->left || src_box->top
+            || src_box->right != width || src_box->bottom != height
+            || format_gl->f.conv_byte_count || dst_format->id != src->resource.format->id
+            || !(src->resource.bind_flags & WINED3D_BIND_RENDER_TARGET))
+        return FALSE;
+
+    wined3d_context_gl_apply_fbo_state_explicit(context_gl, GL_READ_FRAMEBUFFER,
+            &src->resource, 0, NULL, 0, src_location);
+    gl_info->gl_ops.gl.p_glReadBuffer(GL_COLOR_ATTACHMENT0);
+    wined3d_context_gl_check_fbo_status(context_gl, GL_READ_FRAMEBUFFER);
+    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, wined3d_bo_gl(dst_bo_addr->buffer_object)->id));
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, dst_row_pitch / format_gl->f.byte_count);
+    gl_info->gl_ops.gl.p_glReadPixels(0, 0, width, height, format_gl->format, format_gl->type,
+            (uint8_t *)dst_bo_addr->addr + dst_bo_addr->buffer_object->buffer_offset);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, 0));
+    checkGLcall("Cinecore glReadPixels into PBO");
+    if (!logged++) MESSAGE("Cinecore: PBO readback via glReadPixels %ux%u.\n", width, height);
+    return TRUE;
+}
