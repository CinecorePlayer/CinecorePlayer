+/* Cinecore: vertical sync of the video layer. The D3D11->Metal layer (DXMT) creates its CAMetalLayer with
+ * displaySyncEnabled = NO: a present reaches the panel as soon as it is issued, in the middle of a scan-out, and
+ * the picture tears (seen with madVR and MPC-VR on 12/11/2026; -presentedTime fell a quarter of a period before the
+ * vsync). Forced to YES for every Metal layer of the process: measured with madVR, every frame lands exactly on a
+ * vsync, one vsync after the requested one, with the same cadence and no dropped frames.
+ * CINECORE_DISPLAY_SYNC=0 restores the old behaviour. */
+#import <QuartzCore/CAMetalLayer.h>
+#import <objc/runtime.h>
+static void (*cinecore_orig_set_sync)(id, SEL, BOOL);
+static void cinecore_hook_set_sync(id self, SEL _cmd, BOOL on) { (void)on; cinecore_orig_set_sync(self, _cmd, YES); }
+__attribute__((constructor)) static void cinecore_display_sync(void)
+{
+    const char *e = getenv("CINECORE_DISPLAY_SYNC"); Method m;
+    if (e && *e == '0') return;
+    m = class_getInstanceMethod([CAMetalLayer class], @selector(setDisplaySyncEnabled:));
+    if (!m) return;
+    cinecore_orig_set_sync = (void (*)(id, SEL, BOOL))method_getImplementation(m);
+    method_setImplementation(m, (IMP)cinecore_hook_set_sync);
+    fprintf(stderr, "cinecore: sincronia verticale del livello video forzata (pid %d)\n", getpid());
+}
