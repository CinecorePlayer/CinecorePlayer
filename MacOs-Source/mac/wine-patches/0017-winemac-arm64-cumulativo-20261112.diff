  *
  * Run a block on the main thread synchronously.
  */
+/* Cinecore: traccia facoltativa (CINECORE_WINEMAC_TRACE=file) di chi passa blocchi a OnMainThread, per trovare il
+ * blocco il cui rilascio va in crash sul thread principale (SEGV in __destroy_helper_block, 11/11). */
+#include <dlfcn.h>
+#include <objc/runtime.h>
+#include <pthread.h>
+static FILE *cinecore_trace;
+static pthread_mutex_t cinecore_trace_lock = PTHREAD_MUTEX_INITIALIZER;
+static void cinecore_trace_block(const char *what, void *block, void *caller)
+{
+    static int checked;
+    Dl_info bi = {0}, ci = {0};
+    void *invoke;
+    if (!checked)
+    {
+        const char *path = getenv("CINECORE_WINEMAC_TRACE");
+        checked = 1;
+        if (path && *path)
+        {
+            char name[1024];
+            /* un file per processo: anche explorer e gli altri processi Wine caricano winemac */
+            snprintf(name, sizeof(name), "%s.%d", path, (int)getpid());
+            cinecore_trace = fopen(name, "a");
+        }
+    }
+    if (!cinecore_trace || !block) return;
+    invoke = *(void **)((char *)block + 16); /* Block_layout: isa, flags, reserved, invoke */
+    dladdr(invoke, &bi);
+    dladdr(caller, &ci);
+    pthread_mutex_lock(&cinecore_trace_lock);
+    fprintf(cinecore_trace, "%.3f %s %p blocco=%s chiamante=%s+%ld\n", CFAbsoluteTimeGetCurrent(), what, block,
+            bi.dli_sname ? bi.dli_sname : "?", ci.dli_sname ? ci.dli_sname : "?",
+            ci.dli_saddr ? (long)((char *)caller - (char *)ci.dli_saddr) : 0L);
+    fflush(cinecore_trace);
+    pthread_mutex_unlock(&cinecore_trace_lock);
+}
+
+void cinecore_trace_text(const char *fmt, ...)
+{
+    va_list args;
+    cinecore_trace_block("init", NULL, NULL); /* apre il file alla prima chiamata */
+    if (!cinecore_trace) return;
+    pthread_mutex_lock(&cinecore_trace_lock);
+    fprintf(cinecore_trace, "%.3f ", CFAbsoluteTimeGetCurrent());
+    va_start(args, fmt); vfprintf(cinecore_trace, fmt, args); va_end(args);
+    fputc('\n', cinecore_trace); fflush(cinecore_trace);
+    pthread_mutex_unlock(&cinecore_trace_lock);
+}
+
+/* Cinecore: indirizzi dei blocchi eseguiti sul thread principale; per l'involucro di OnMainThread anche il blocco
+ * annidato (offset 48) con i suoi flag, per riconoscere un uso dopo la liberazione. */
+void cinecore_trace_request(const char *what, void *block)
+{
+    Dl_info bi = {0};
+    void *invoke;
+    cinecore_trace_block("init", NULL, NULL);
+    if (!cinecore_trace || !block) return;
+    invoke = *(void **)((char *)block + 16);
+    dladdr(invoke, &bi);
+    pthread_mutex_lock(&cinecore_trace_lock);
+    if (bi.dli_sname && strstr(bi.dli_sname, "OnMainThread_block_invoke") && !strstr(bi.dli_sname, "Async"))
+    {
+        void *inner = *(void **)((char *)block + 48);
+        Dl_info ii = {0};
+        unsigned int iflags = inner ? *(unsigned int *)((char *)inner + 8) : 0;
+        if (inner) dladdr(*(void **)((char *)inner + 16), &ii);
+        void *obj = NULL;
+        unsigned long rc = 0;
+        const char *cls = "";
+        /* primo oggetto catturato dal blocco interno, se c'e' (es. self in -[WineOpenGLContext clearDrawable]) */
+        if (0) /* dopo la correzione 0012 i blocchi del contesto non contengono piu' l'oggetto */
+        {
+            obj = *(void **)((char *)inner + 32);
+            if (obj && strstr(ii.dli_sname, "WineOpenGLContext"))
+            {
+                rc = (unsigned long)[(id)obj retainCount];
+                cls = object_getClassName((id)obj);
+            }
+        }
+        fprintf(cinecore_trace, "%.3f %s %p flags=%08x avvolge=%p iflags=%08x desc=%p interno=%s obj=%p rc=%lu %s thr=%p\n", CFAbsoluteTimeGetCurrent(), what, block,
+                *(unsigned int *)((char *)block + 8), inner, iflags, inner ? *(void **)((char *)inner + 24) : NULL,
+                ii.dli_sname ? ii.dli_sname : "?", obj, rc, cls, (void *)pthread_self());
+    }
+    else
+        fprintf(cinecore_trace, "%.3f %s %p flags=%08x %s\n", CFAbsoluteTimeGetCurrent(), what, block,
+                *(unsigned int *)((char *)block + 8), bi.dli_sname ? bi.dli_sname : "?");
+    fflush(cinecore_trace);
+    pthread_mutex_unlock(&cinecore_trace_lock);
+}
+
 void OnMainThread(dispatch_block_t block)
 {
 @autoreleasepool
 {
+    cinecore_trace_block("sync", (__bridge void *)block, __builtin_return_address(0));
     NSMutableDictionary* threadDict = [[NSThread currentThread] threadDictionary];
     WineEventQueue* queue = threadDict[WineEventQueueThreadDictionaryKey];
     dispatch_semaphore_t semaphore = NULL;
