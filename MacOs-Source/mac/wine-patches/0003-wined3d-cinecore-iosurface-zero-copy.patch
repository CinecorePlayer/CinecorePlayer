+/* Self-contained: Wine's Windows headers redefine BOOL and clash with Objective-C. Must match unixlib.h. */
+typedef unsigned int NTSTATUS;
+typedef NTSTATUS (*unixlib_entry_t)(void *args);
+#define STATUS_SUCCESS 0
+#define STATUS_UNSUCCESSFUL 0xC0000001
+enum { unix_cinecore_surface_create = 4, unix_cinecore_surface_blit = 5 };
+struct cinecore_surface_create_params { uint32_t width, height, id; };
+struct cinecore_surface_blit_params { uint32_t id, src_texture, width, height, ok; };
+
+static pthread_mutex_t cc_lock = PTHREAD_MUTEX_INITIALIZER;
+static IOSurfaceRef cc_pending;
+static pthread_t cc_pending_thread; /* only the thread that asked for the surface may take it */
+static char cc_key_surface, cc_key_port;
+static Class cc_handle_class;
+static IMP orig_new_shared_desc, orig_new_shared_handle_dev, orig_tex_new_handle, orig_handle_init_port;
+static BOOL cc_swizzled;
+
+static IOSurfaceRef cc_surface_of(id obj)
+{
+    return obj ? (IOSurfaceRef)objc_getAssociatedObject(obj, &cc_key_surface) : NULL;
+}
+
+static void cc_set_surface(id obj, IOSurfaceRef surface)
+{
+    objc_setAssociatedObject(obj, &cc_key_surface, (id)surface, OBJC_ASSOCIATION_RETAIN);
+}
+
+/* -[CinecoreSurfaceHandle createMachPort] */
+static mach_port_t cc_handle_create_port(id self, SEL cmd)
+{
+    IOSurfaceRef s = cc_surface_of(self);
+    return s ? IOSurfaceCreateMachPort(s) : MACH_PORT_NULL;
+}
+
+static id cc_new_surface_handle(IOSurfaceRef s)
+{
+    id h = [[cc_handle_class alloc] init];
+    cc_set_surface(h, s);
+    return h;
+}
+
+static id<MTLTexture> cc_texture_on_surface(id<MTLDevice> dev, IOSurfaceRef s)
+{
+    MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA16Float
+            width:IOSurfaceGetWidth(s) height:IOSurfaceGetHeight(s) mipmapped:NO];
+    d.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite | MTLTextureUsageRenderTarget;
+    d.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [dev newTextureWithDescriptor:d iosurface:s plane:0];
+    if (t) cc_set_surface(t, s);
+    return t;
+}
+
+/* -[MTLDevice newSharedTextureWithDescriptor:] */
+static id cc_new_shared_desc(id self, SEL cmd, MTLTextureDescriptor *desc)
+{
+    IOSurfaceRef s = NULL;
+
+    pthread_mutex_lock(&cc_lock);
+    if (cc_pending && pthread_equal(cc_pending_thread, pthread_self()) && desc.pixelFormat == MTLPixelFormatRGBA16Float && desc.width == IOSurfaceGetWidth(cc_pending)
+            && desc.height == IOSurfaceGetHeight(cc_pending))
+    {
+        s = cc_pending;
+        cc_pending = NULL;
+    }
+    pthread_mutex_unlock(&cc_lock);
+    if (s)
+    {
+        id<MTLTexture> t = cc_texture_on_surface(self, s);
+        CFRelease(s);
+        if (t)
+        {
+            fprintf(stderr, "Cinecore: shared Metal texture %lux%lu on IOSurface %u.\n",
+                    (unsigned long)t.width, (unsigned long)t.height, IOSurfaceGetID(cc_surface_of(t)));
+            return t;
+        }
+    }
+    return ((id (*)(id, SEL, MTLTextureDescriptor *))orig_new_shared_desc)(self, cmd, desc);
+}
+
+/* -[MTLTexture newSharedTextureHandle] */
+static id cc_tex_new_handle(id self, SEL cmd)
+{
+    IOSurfaceRef s = cc_surface_of(self);
+    if (s) return cc_new_surface_handle(s);
+    return ((id (*)(id, SEL))orig_tex_new_handle)(self, cmd);
+}
+
+/* -[MTLSharedTextureHandle initWithMachPort:] */
+static id cc_handle_init_port(id self, SEL cmd, mach_port_t port)
+{
+    IOSurfaceRef s = IOSurfaceLookupFromMachPort(port);
+    if (s && IOSurfaceGetWidth(s) > 0 && IOSurfaceGetPixelFormat(s) == 'RGhA')
+    {
+        /* One of ours: a linear IOSurface, not the GPU-private backing of a Metal shared texture. */
+        id h = [[cc_handle_class alloc] init];
+        cc_set_surface(h, s);
+        CFRelease(s);
+        [self release];
+        return h;
+    }
+    if (s) CFRelease(s);
+    return ((id (*)(id, SEL, mach_port_t))orig_handle_init_port)(self, cmd, port);
+}
+
+/* -[MTLDevice newSharedTextureWithHandle:] */
+static id cc_new_shared_handle_dev(id self, SEL cmd, id handle)
+{
+    IOSurfaceRef s = cc_surface_of(handle);
+    if (s)
+    {
+        id<MTLTexture> t = cc_texture_on_surface(self, s);
+        if (t) return t;
+    }
+    return ((id (*)(id, SEL, id))orig_new_shared_handle_dev)(self, cmd, handle);
+}
+
+static BOOL cc_swizzle(Class cls, SEL sel, IMP imp, IMP *orig)
+{
+    Method m = class_getInstanceMethod(cls, sel);
+    if (!m) return FALSE;
+    *orig = method_setImplementation(m, imp);
+    return TRUE;
+}
+
+static BOOL cc_install(void)
+{
+    @autoreleasepool
+    {
+        id<MTLDevice> dev;
+        IOSurfaceRef probe;
+        id<MTLTexture> tex, priv;
+        MTLTextureDescriptor *d;
+        Class base;
+        BOOL ok = TRUE;
+
+        if (cc_swizzled) return TRUE;
+        fprintf(stderr, "Cinecore: install 1\n");
+        if (!(dev = MTLCreateSystemDefaultDevice())) return FALSE;
+        fprintf(stderr, "Cinecore: install 2 dev=%p\n", dev);
+        base = NSClassFromString(@"MTLSharedTextureHandle");
+        if (!base) return FALSE;
+        cc_handle_class = objc_allocateClassPair(base, "CinecoreSurfaceHandle", 0);
+        class_addMethod(cc_handle_class, sel_registerName("createMachPort"), (IMP)cc_handle_create_port, "I@:");
+        objc_registerClassPair(cc_handle_class);
+        fprintf(stderr, "Cinecore: install 3 base=%p cls=%p\n", base, cc_handle_class);
+
+        /* Concrete classes: textures on IOSurface and private shared textures can differ. */
+        probe = IOSurfaceCreate((CFDictionaryRef)@{ (id)kIOSurfaceWidth: @16, (id)kIOSurfaceHeight: @16,
+                (id)kIOSurfaceBytesPerElement: @8, (id)kIOSurfacePixelFormat: @((uint32_t)'RGhA') });
+        d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA16Float width:16 height:16 mipmapped:NO];
+        d.storageMode = MTLStorageModeShared;
+        tex = [dev newTextureWithDescriptor:d iosurface:probe plane:0];
+        d.storageMode = MTLStorageModePrivate;
+        priv = [dev newSharedTextureWithDescriptor:d];
+        fprintf(stderr, "Cinecore: install 4 probe=%p tex=%p priv=%p\n", probe, tex, priv);
+
+        ok &= cc_swizzle([dev class], @selector(newSharedTextureWithDescriptor:), (IMP)cc_new_shared_desc, &orig_new_shared_desc);
+        ok &= cc_swizzle([dev class], @selector(newSharedTextureWithHandle:), (IMP)cc_new_shared_handle_dev, &orig_new_shared_handle_dev);
+        if (tex) ok &= cc_swizzle([tex class], @selector(newSharedTextureHandle), (IMP)cc_tex_new_handle, &orig_tex_new_handle);
+        if (priv && [priv class] != [tex class])
+        {
+            IMP unused;
+            /* The private class keeps its own implementation; ours only answers for IOSurface textures. */
+            (void)unused;
+        }
+        ok &= cc_swizzle(base, sel_registerName("initWithMachPort:"), (IMP)cc_handle_init_port, &orig_handle_init_port);
+        [tex release]; [priv release]; CFRelease(probe); [dev release];
+        cc_swizzled = ok;
+        fprintf(stderr, "Cinecore: IOSurface sharing hooks %s.\n", ok ? "installed" : "FAILED");
+        return ok;
+    }
+}
+
+static NTSTATUS cinecore_surface_create(void *args)
+{
+    struct cinecore_surface_create_params *params = args;
+    IOSurfaceRef s;
+    size_t bpr;
+
+    params->id = 0;
+    fprintf(stderr, "Cinecore: create %ux%u\n", params->width, params->height);
+    if (!cc_install()) return STATUS_UNSUCCESSFUL;
+    fprintf(stderr, "Cinecore: create after install\n");
+    bpr = IOSurfaceAlignProperty(kIOSurfaceBytesPerRow, (size_t)params->width * 8);
+    s = IOSurfaceCreate((CFDictionaryRef)@{ (id)kIOSurfaceWidth: @(params->width), (id)kIOSurfaceHeight: @(params->height),
+            (id)kIOSurfaceBytesPerElement: @8, (id)kIOSurfaceBytesPerRow: @(bpr),
+            (id)kIOSurfacePixelFormat: @((uint32_t)'RGhA') });
+    if (!s) return STATUS_UNSUCCESSFUL;
+    pthread_mutex_lock(&cc_lock);
+    if (cc_pending) CFRelease(cc_pending);
+    cc_pending = s; /* taken by the next shared RGBA16Float Metal texture of this size, on this thread */
+    cc_pending_thread = pthread_self();
+    pthread_mutex_unlock(&cc_lock);
+    params->id = IOSurfaceGetID(s);
+    return STATUS_SUCCESS;
+}
+
+/* GL side, on the thread with wined3d's context current. */
+static struct { uint32_t id; GLuint rect; uint32_t width, height; } cc_gl[16];
+/* Framebuffer objects are not shared between GL contexts, and wined3d uses several: one pair per context. */
+static struct { CGLContextObj ctx; uint32_t id; GLuint fbo_read, fbo_draw; } cc_fbo[64];
+
+static NTSTATUS cinecore_surface_blit(void *args)
+{
+    struct cinecore_surface_blit_params *params = args;
+    CGLContextObj ctx = CGLGetCurrentContext();
+    GLint prev_read, prev_draw, prev_rect;
+    GLboolean scissor, srgb;
+    GLuint fbo_read, fbo_draw;
+    unsigned int i;
+
+    params->ok = 0;
+    if (!ctx || !params->id) return STATUS_UNSUCCESSFUL;
+    for (i = 0; i < 16 && cc_gl[i].id && cc_gl[i].id != params->id; ++i);
+    if (i == 16) return STATUS_UNSUCCESSFUL;
+
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prev_read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prev_draw);
+    if (!cc_gl[i].id)
+    {
+        IOSurfaceRef s = IOSurfaceLookup(params->id);
+        CGLError err;
+        if (!s) return STATUS_UNSUCCESSFUL;
+        glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &prev_rect);
+        glGenTextures(1, &cc_gl[i].rect);
+        glBindTexture(GL_TEXTURE_RECTANGLE, cc_gl[i].rect);
+        err = CGLTexImageIOSurface2D(ctx, GL_TEXTURE_RECTANGLE, GL_RGBA16F, (GLsizei)IOSurfaceGetWidth(s),
+                (GLsizei)IOSurfaceGetHeight(s), GL_RGBA, GL_HALF_FLOAT, s, 0);
+        glBindTexture(GL_TEXTURE_RECTANGLE, prev_rect);
+        cc_gl[i].width = (uint32_t)IOSurfaceGetWidth(s);
+        cc_gl[i].height = (uint32_t)IOSurfaceGetHeight(s);
+        CFRelease(s);
+        if (err != kCGLNoError)
+        {
+            fprintf(stderr, "Cinecore: CGLTexImageIOSurface2D failed, error %d.\n", err);
+            glDeleteTextures(1, &cc_gl[i].rect);
+            return STATUS_UNSUCCESSFUL;
+        }
+        cc_gl[i].id = params->id;
+        fprintf(stderr, "Cinecore: IOSurface %u bound to GL texture %u (%ux%u).\n", params->id, cc_gl[i].rect,
+                cc_gl[i].width, cc_gl[i].height);
+    }
+
+    {
+        unsigned int f, free_slot = 64;
+        for (f = 0; f < 64; ++f)
+        {
+            if (cc_fbo[f].ctx == ctx && cc_fbo[f].id == params->id) break;
+            if (!cc_fbo[f].ctx && free_slot == 64) free_slot = f;
+        }
+        if (f == 64)
+        {
+            if (free_slot == 64) return STATUS_UNSUCCESSFUL;
+            f = free_slot;
+            cc_fbo[f].ctx = ctx; cc_fbo[f].id = params->id;
+            glGenFramebuffers(1, &cc_fbo[f].fbo_read);
+            glGenFramebuffers(1, &cc_fbo[f].fbo_draw);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, cc_fbo[f].fbo_draw);
+            glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE, cc_gl[i].rect, 0);
+            if (glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+                fprintf(stderr, "Cinecore: IOSurface framebuffer incomplete %#x.\n", glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER));
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, prev_draw);
+        }
+        fbo_read = cc_fbo[f].fbo_read; fbo_draw = cc_fbo[f].fbo_draw;
+    }
+    while (glGetError() != GL_NO_ERROR); /* errors left by wined3d are not ours */
+    scissor = glIsEnabled(GL_SCISSOR_TEST);
+    srgb = glIsEnabled(GL_FRAMEBUFFER_SRGB);
+#define CC_CHECK(what) do { GLenum e_ = glGetError(); static int n_; if (e_ && n_++ < 3) fprintf(stderr, "Cinecore: %s -> %#x\n", what, e_); } while (0)
+    /* The read framebuffer (madVR's texture) was set up by wined3d itself on the Windows side. */
+    (void)fbo_read;
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbo_draw); CC_CHECK("bind draw");
+    if (scissor) glDisable(GL_SCISSOR_TEST);
+    if (srgb) glDisable(GL_FRAMEBUFFER_SRGB);
+    glBlitFramebuffer(0, 0, params->width, params->height, 0, 0, params->width, params->height,
+            GL_COLOR_BUFFER_BIT, GL_NEAREST); CC_CHECK("blit");
+    if (scissor) glEnable(GL_SCISSOR_TEST);
+    if (srgb) glEnable(GL_FRAMEBUFFER_SRGB);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, prev_draw);
+    {
+        GLenum e = glGetError();
+        static int logged;
+        params->ok = e == GL_NO_ERROR;
+        if (!params->ok && logged++ < 5) fprintf(stderr, "Cinecore: blit GL error %#x.\n", e);
+    }
+    return STATUS_SUCCESS;
+}
+
+__attribute__((visibility("default"))) const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    [unix_cinecore_surface_create] = cinecore_surface_create,
+    [unix_cinecore_surface_blit] = cinecore_surface_blit,
+};
+
+__attribute__((visibility("default"))) const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    [unix_cinecore_surface_create] = cinecore_surface_create,
+    [unix_cinecore_surface_blit] = cinecore_surface_blit,
+};
+
+#endif
