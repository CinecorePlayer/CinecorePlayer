+/* Cinecore: called from the CS thread's query polling (it runs continuously while madVR has event queries
+ * pending): finished copies are marked done as soon as the GPU is through, not at the next download. */
+void cinecore_cs_poll(struct wined3d_device *device)
+{
+    struct wined3d_context *context;
+    unsigned int i;
+    BOOL busy = FALSE;
+
+    if (!cinecore.ready || device != cinecore.device) return;
+    for (i = 0; i < ARRAY_SIZE(cinecore.p); ++i)
+        if (cinecore.p[i].state == CC_READING || cinecore.p[i].state == CC_COPIED) { busy = TRUE; break; }
+    if (!busy) return;
+    context = context_acquire(device, NULL, 0);
+    cinecore_collect(wined3d_context_gl(context)->gl_info);
+    context_release(context);
+}
