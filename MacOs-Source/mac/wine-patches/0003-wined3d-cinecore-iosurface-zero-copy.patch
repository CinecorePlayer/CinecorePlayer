+/* Cinecore: creates a linear half-float IOSurface; the next shared RGBA16Float Metal texture of this size is
+ * created on it. Returns the IOSurfaceID (0 on failure). */
+UINT CDECL cinecore_surface_create(UINT width, UINT height)
+{
+    struct cinecore_surface_create_params params = { width, height, 0 };
+    NTSTATUS st;
+    if ((st = __wine_init_unix_call())) { ERR("Cinecore: Unix library not loaded, status %#lx.\n", st); return 0; }
+    if ((st = WINE_UNIX_CALL(unix_cinecore_surface_create, &params))) { ERR("Cinecore: surface_create status %#lx.\n", st); return 0; }
+    return params.id;
+}
