+/* Le nostre superfici non sono nell'elenco che win32u aggiorna (use_window_client_surface non e' esportata): senza
+ * questo la vista Cocoa resta alla misura che la finestra aveva quando DXMT ha creato la swapchain (MPC Video
+ * Renderer la crea su una finestra figlia ancora 0x0 e poi la ingrandisce: video nero). Chiamata da
+ * macdrv_WindowPosChanged: si riallineano le viste della stessa finestra principale; si liberano quelle delle
+ * finestre distrutte. */
+void dxmt_window_pos_changed(HWND hwnd)
+{
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
+    int i;
+
+    pthread_mutex_lock(&dxmt_mutex);
+    for (i = 0; i < MAX_DXMT_SURFACES; i++)
+    {
+        struct macdrv_win_data *data;
+        HWND owner = dxmt_surfaces[i].hwnd;
+        if (!owner) continue;
+        if (!(data = get_win_data(owner)))
+        {
+            client_surface_release(dxmt_surfaces[i].surface);
+            dxmt_surfaces[i].hwnd = NULL;
+            dxmt_surfaces[i].surface = NULL;
+            continue;
+        }
+        release_win_data(data);
+        if (owner == hwnd || NtUserGetAncestor(owner, GA_ROOT) == root)
+            client_surface_present(dxmt_surfaces[i].surface);
+    }
+    pthread_mutex_unlock(&dxmt_mutex);
+}
+
 static struct macdrv_win_data *dxmt_get_win_data(HWND hwnd)
 {
     struct macdrv_win_data *data;
