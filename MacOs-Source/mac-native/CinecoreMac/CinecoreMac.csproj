  <ItemGroup>
    <!-- Icone e caratteri dell'app Windows, identici. -->
    <Content Include="..\..\Assets\icons\**\*.svg" Link="Assets\icons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\hud_icons\**\*.svg" Link="Assets\hud_icons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\Icons.Uniform\*.svg" Link="Assets\Icons.Uniform\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\Icons.Lucide\*.svg" Link="Assets\Icons.Lucide\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\Icons.Custom\*.svg" Link="Assets\Icons.Custom\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\hud_icons_new\**\*.svg" Link="Assets\hud_icons_new\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\Network\*.jpg" Link="Assets\Network\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\HeroPlaceholders\*.jpg" Link="Assets\HeroPlaceholders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="..\..\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <AvaloniaResource Include="Lang\*.tsv" />
    <AvaloniaResource Include="..\..\Splash\*.png" Link="Splash\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
