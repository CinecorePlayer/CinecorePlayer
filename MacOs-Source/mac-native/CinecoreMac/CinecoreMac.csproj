    <Compile Include="..\..\Utilities\ExternalRatingsService.cs" Link="Shared\ExternalRatingsService.cs" />
    <Compile Include="..\..\Utilities\LastFmSimilar.cs" Link="Shared\LastFmSimilar.cs" />
    <Compile Include="..\..\Utilities\MusicArtistArtworkService*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\..\Utilities\MusicArtworkService.cs" Link="Shared\MusicArtworkService.cs" />
    <Compile Include="..\..\Utilities\MusicCatalog.cs" Link="Shared\MusicCatalog.cs" />
    <Compile Include="..\..\Utilities\SpotifyArtistArtworkService.cs" Link="Shared\SpotifyArtistArtworkService.cs" />
    <Compile Include="..\..\Utilities\TidalArtistArtworkService.cs" Link="Shared\TidalArtistArtworkService.cs" />
