<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cinecore Player per macOS (nativo, Apple Silicon). L'interfaccia e' disegnata qui con Avalonia; il video lo
       mostra il VideoHost (madVR / MPC Video Renderer) sotto Wine, in una finestra allineata sotto l'HUD. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);CINECORE_MAC</DefineConstants>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>CinecoreMac</AssemblyName>
    <Version>0.1.1</Version>
    <InformationalVersion>Beta 1.1</InformationalVersion>
    <RootNamespace>CinecoreMac</RootNamespace>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Nomi delle tracce audio ripuliti come su Windows: lo stesso file. -->
    <Compile Include="..\..\Utilities\SubtitleNameNormalizer.cs" Link="Shared\SubtitleNameNormalizer.cs" />
    <Compile Include="..\..\Utilities\AppDataPaths.cs" Link="Shared\AppDataPaths.cs" />
    <!-- Metadati di film e serie (TMDb), riconoscimento di titolo, anno ed episodi: gli stessi file di Windows. -->
    <Compile Include="..\..\Utilities\MovieMetadataService*.cs" Link="Shared\%(Filename)%(Extension)" />
    <!-- Server Jellyfin ed Emby: lo stesso client di Windows. -->
    <Compile Include="..\..\Utilities\JellyfinClient.cs" Link="Shared\JellyfinClient.cs" />
    <!-- Punto di ripresa dei file locali ("Continua a guardare"): lo stesso registro di Windows. -->
    <Compile Include="..\..\Engines\PlaybackResumeStore.cs" Link="Shared\PlaybackResumeStore.cs" />
    <Compile Include="..\..\Utilities\HiddenLibraryStore.cs" Link="Shared\HiddenLibraryStore.cs" />
    <Compile Include="..\..\Utilities\MusicTextIdentity.cs" Link="Shared\MusicTextIdentity.cs" />
    <Compile Include="..\..\Utilities\MusicLyricsService*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\..\Utilities\LyricsSynchronization.cs" Link="Shared\LyricsSynchronization.cs" />
    <Compile Include="..\..\Utilities\ProviderBackoff.cs" Link="Shared\ProviderBackoff.cs" />
    <Compile Include="..\..\Utilities\GeniusClient.cs" Link="Shared\GeniusClient.cs" />
