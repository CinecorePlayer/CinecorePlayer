<?xml version="1.0" encoding="utf-8"?>
<!-- Solo la compatibilita' dichiarata, come la release Windows. Senza, Windows presenta al processo la versione
     "Windows 8": MPC Video Renderer lo scriveva nelle sue statistiche e spegneva RTX Video HDR e il passthrough HDR.
     La gestione DPI resta quella di prima: la finestra del video non cambia misura. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Cinecore.VideoHost"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1, 8, 7 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
    </application>
  </compatibility>
</assembly>
