<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(CinecoreMacBundle)' != 'true'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(CinecoreMacBundle)' == 'true'">net9.0</TargetFramework>
    <DefineConstants Condition="'$(CinecoreMacBundle)' == 'true'">$(DefineConstants);CINECORE_MAC_BUNDLE</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>IntroOutroDetector</AssemblyName>
    <RootNamespace>IntroOutroDetector</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
