<UserControl x:Class="CinecorePlayer2025.Splash.CinecoreSplash"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#070C12"
             Focusable="False"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             SizeChanged="OnSizeChanged"
             PreviewKeyDown="OnPreviewKeyDown"
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid x:Name="Stage" Background="#070C12">
        <Grid x:Name="CenterHost"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Grid x:Name="LogoGrid"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.96" ScaleY="0.96" />
                </Grid.RenderTransform>

                <Image x:Name="GhostImage"
                       Source="pack://application:,,,/CinecorePlayer2025;component/Splash/logo_ghost.png"
                       Stretch="Uniform"
                       Opacity="0" />

                <Image x:Name="LitImage"
                       Source="pack://application:,,,/CinecorePlayer2025;component/Splash/logo.png"
                       Stretch="Uniform">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" SpreadMethod="Pad">
                            <GradientStop x:Name="MaskStart" Color="#FFFFFFFF" Offset="0" />
                            <GradientStop x:Name="MaskSolidEnd" Color="#FFFFFFFF" Offset="0" />
                            <GradientStop x:Name="MaskFadeEnd" Color="#00FFFFFF" Offset="0" />
                            <GradientStop x:Name="MaskEnd" Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>

                <!-- Piccolo layer più luminoso usato solo nel flash di uscita. -->
                <Image x:Name="FlashImage"
                       Source="pack://application:,,,/CinecorePlayer2025;component/Splash/logo_bright.png"
                       Stretch="Uniform"
                       Opacity="0"
                       IsHitTestVisible="False" />
            </Grid>

        </Grid>

        <TextBlock x:Name="StatusText"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   FontFamily="Segoe UI Variable Display, Segoe UI"
                   FontSize="15"
                   Foreground="#7D8BA0"
                   Opacity="0"
                   Text="Avvio di CinecorePlayer">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="StatusTranslate" Y="0" />
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="MadVrCredit"
                   Text="Powered by madVR"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Right"
                   FontFamily="Segoe UI Variable Display, Segoe UI"
                   FontSize="12"
                   Foreground="#647286"
                   Opacity="0.8" />
    </Grid>
</UserControl>
